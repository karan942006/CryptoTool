# ============================================================
# CRYPTOTOOL (ECDAT — SIH26164)
# Environment Configuration Template
# ============================================================

# Application Environment
NODE_ENV=development
PORT=3001
FRONTEND_PORT=5173

# Supabase Configuration
# Frontend Safe (Public) Keys
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Server-side Only Keys (DO NOT EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# AI Security Analyst (Gemini API)
# Server-side Only (Never exposed to frontend)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Background Job Queue (Optional: In-memory fallback is active if empty)
REDIS_URL=redis://localhost:6379

# Storage Bucket
REPORT_STORAGE_BUCKET=cryptotool-reports

# Security & Sessions
JWT_SECRET=super-secret-crypto-tool-jwt-signing-key-32-chars
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Scanner Settings
MAX_UPLOAD_SIZE_MB=100
SCAN_TIMEOUT_SECONDS=120
DEMO_MODE_ENABLED=true
